# =============================================================================
# network_ops —— **compose 自己的**变量文件
# =============================================================================
# 用法：
#     cp .env.example .env        # 然后按需修改；.env 已被 .gitignore 忽略
#
# 这个文件只服务 docker compose 本身：compose 会自动加载它，用于 docker-compose.yml 里
# 的 `${VAR:-默认值}` 替换。它**不会**被注入容器（compose 只把它当变量来源）。
#
# 三类配置各归各处，别放混：
#   .env（本文件）  → compose 插值：宿主映射端口、镜像、secrets 文件路径
#   envs/*.env      → 容器与宿主**共用的一套**（容器按服务 env_file 注入，宿主由 base.py
#                     的 load_dotenv 读），三层 + 服务层：
#                       envs/common.env     共享值（日常唯一维护的地方）
#                       envs/container.env  容器差异（HOST=db/redis、*_FILE、DJANGO_ENV）
#                       envs/host.env       宿主差异（HOST=localhost 等，不进容器）
#                       envs/gunicorn.env   只给 app（GUNICORN_* 旋钮）
#                       envs/celery.env     只给 worker（CELERY_LOGLEVEL）
#   envs/secrets/*  → 数据库与阿里云凭据（docker secrets，进容器是 /run/secrets/*）
#                       生成：bash envs/secrets/generate.sh
# 详见 envs/README.md 与 envs/secrets/README.md。
#
# ⚠️ compose 的 ${VAR} **只读本文件**，读不到 envs/*.env。反过来，容器里的变量只要在
#    envs/*.env 里就够了，不必在这里重复。
#
# 语法要点（compose 的 dotenv 解析规则，实测，envs/*.env 同样适用）：
#   * `#` 前面只要有空格就当成行内注释：`B=p #ss` 得到 "p"；紧贴着则保留：`A=p#ss` 得到 "p#ss"
#   * `$` 会做变量插值：`pa$word` 得到 "pa"（$word 未定义，被替换成空）
#     想要字面量 $ 就写 `$$`（`pa$$word` → "pa$word"），或用单引号 `'pa$word'`
#   * 行尾空格会被去掉；普通值不需要引号，只有含上面这些特殊字符时才需要
# =============================================================================

# -----------------------------------------------------------------------------
# 宿主映射端口（**不是**容器内端口）
# -----------------------------------------------------------------------------
# 只影响「宿主机 → 容器」的端口映射；数据库端口按后端分开，见下面「数据库」段
# （容器内固定 5432 / 3306，app/worker 用服务名 db 连接，见 envs/container.env 的 DB_HOST）

# 同样只影响宿主机映射端口；容器内 app/worker 固定连 redis:6379（那个 6379 在
# envs/common.env 的 REDIS_PORT 里，和这里的宿主映射是两回事，所以名字分开）
REDIS_HOST_PORT=6379

# nginx 统一入口
NGINX_PORT=8000
NGINX_SSL_PORT=8443

# -----------------------------------------------------------------------------
# 镜像构建
# -----------------------------------------------------------------------------
# 构建顺序（链式继承，文件名全小写）：
#   dockerfile.base → network-ops-base:py312          （OS 运行时：git / libpq5）
#   dockerfile.venv → network-ops-venv:<tag>          （Python venv：uv sync 产物）
#   dockerfile.code → network-ops-code:<git-sha>      （代码镜像：busybox + 代码 + 静态成品，~6.8MB）
#   dockerfile      → network-ops:<tag>               （项目镜像：源码 + 静态成品，传统方案）
#
# 代码镜像用 git SHA 做 tag（不用 latest，无法回滚与追溯）。跨沙箱部署：
#   内网开发机：
#     TAG=$(git rev-parse --short HEAD)
#     docker build -t network-ops-code:$TAG -f dockerfile.code .
#     docker save network-ops-code:$TAG | gzip -9 > code-$TAG.tar.gz
#     scp code-$TAG.tar.gz server:/opt/images/
#   服务器：
#     gunzip -c /opt/images/code-$TAG.tar.gz | docker load
#     cd /opt/netops && CODE_IMAGE=network-ops-code:$TAG docker compose up -d code-init app
#   回滚（镜像已在服务器上）：
#     CODE_IMAGE=network-ops-code:<旧SHA> docker compose up -d code-init app
#
# 代码镜像（必填，git SHA）
CODE_IMAGE=localhost/network-ops-code:dev

# venv 镜像（app/worker/consumer 启动用；改依赖才重建）
VENV_IMAGE=localhost/network-ops-venv:dev

# 传统方案（代码打进镜像，不挂载）
# APP_IMAGE=network-ops:latest

REDIS_IMAGE=redis:8.8.0

# -----------------------------------------------------------------------------
# 数据库（DB_SERVICE 选模板；DB_* 与镜像名在 envs/common.env 里定义/嵌套）
# -----------------------------------------------------------------------------
# DB_SERVICE 是唯一需要在这里维护的数据库开关：envs/common.env 里
# `DB_ENGINE=${DB_SERVICE:-postgresql}` 由 Compose 加载 env_file 时展开，同时 compose.yml 的
# db 服务用它选模板。DB_NAME / DB_USER 与部署方式无关，直接写在 common.env。
# ⚠️ 切换后端等于换一套数据卷（postgres_data / mysql_data 互不相通），不会迁移旧数据。
DB_SERVICE=postgresql
# 镜像与宿主映射端口按后端分开命名——它们本来就不可能共用一个值
DB_IMAGE_POSTGRES=timescale/timescaledb:2.27.1-pg16
DB_IMAGE_MYSQL=mysql:8.4-oracle
DB_PORT_POSTGRES=5432
DB_PORT_MYSQL=3306

# -----------------------------------------------------------------------------
# 可选：docker secrets 文件的位置
# -----------------------------------------------------------------------------
# 默认是项目里的 ./envs/secrets/db_user 与 ./envs/secrets/db_password。
# 放到别处（例如 /etc/netops/secrets/）时取消注释：
# DB_USER_SECRET_FILE=/etc/netops/secrets/db_user
# DB_PASSWORD_SECRET_FILE=/etc/netops/secrets/db_password

# -----------------------------------------------------------------------------
# 以下只在「宿主机直接跑 Django」（不经容器）时才需要，别为 compose 打开
# -----------------------------------------------------------------------------
# compose 里 app/worker 的环境变量来自 envs/common.env + envs/container.env（DB_HOST=db、
# REDIS_HOST=redis 是写死的服务名）。宿主机直跑时 netops/settings/base.py 自己 load_dotenv
# （envs/common.env，非 container 再叠 envs/host.env，override=False），所以**不用手工 export**：
#     cp envs/example/*.env envs/     # 首次
#     # 真实进程环境变量优先；想完全跳过 envs/ 文件：NETOPS_SKIP_DOTENV=1
#     # DJANGO_ENV 宿主不用设：默认 dev；容器由 envs/container.env 注入 container，生产注入 prod
#     # 凭据：容器用 *_FILE（/run/secrets/*）；宿主可 export 同名变量，或在 host.env 给相对 *_FILE
#
# 配置仓库（git）与配置源（容器部署时不用设，路径由 envs/container.env 与 compose 固定）：
#   CONFIG_REPO_PATH=/configs   ← 命名卷 repo 的挂载点（每台设备一个 git 仓库）
#   配置源目录 = /data/configs  ← 命名卷 data（driver_opts 绑定宿主机 data 目录）下的
#                                  configs/，Excel「配置文件」sheet 的 config_dir 为空时
#                                  的默认值；首次部署先 mkdir -p data（宿主目录不存在时 up 直接失败）
# 宿主机直跑时 CONFIG_REPO_PATH 不设，走默认 <项目根>/data/config_repo，与容器那份互不影响：
#     CONFIG_REPO_PATH=

# 阿里云（AK/SK 也有两种用法：宿主机直跑直接读环境变量；容器部署时 generate.sh 会把
#   ALIYUN_* 四项写进 envs/secrets/*，再由 compose 挂到 /run/secrets/*）：
#     ALIYUN_REGION=cn-hangzhou
#     ALIYUN_PROD_ACCESS_KEY_ID=
#     ALIYUN_PROD_ACCESS_KEY_SECRET=
#     ALIYUN_TEST_ACCESS_KEY_ID=
#     ALIYUN_TEST_ACCESS_KEY_SECRET=
#     ALIYUN_ECS_ENDPOINT=
#     ALIYUN_VPC_ENDPOINT=
#     ALIYUN_SLB_ENDPOINT=
#     ALIYUN_SLS_ENDPOINT=

# -----------------------------------------------------------------------------
# 只在构建 dockerfile.base / dockerfile.venv 时用到的构建参数（不经过 compose，必须用 --build-arg 传）
# -----------------------------------------------------------------------------
# docker build --network=host -f dockerfile.base -t network-ops-base:py312 \
#     --build-arg APT_MIRROR=mirrors.tuna.tsinghua.edu.cn \
#     --build-arg UV_DEFAULT_INDEX=https://mirrors.cloud.tencent.com/pypi/simple .
# （Python 包源要用 uv 自己的 UV_DEFAULT_INDEX：uv 不读 PIP_INDEX_URL / pip.conf）
# venv 镜像构建（BASE_IMAGE 指向上一步产出的 base 镜像）：
# docker build --network=host -f dockerfile.venv -t network-ops-venv:latest \
#     --build-arg BASE_IMAGE=network-ops-base:py312 .
