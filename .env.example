# =============================================================================
# network_ops 环境变量模板
# =============================================================================
# 用法：
#     cp .env.example .env        # 然后按需修改；.env 已被 .gitignore 忽略
#
# 谁读它：
#   * `docker compose` 会自动加载项目根目录的 .env，用于 docker-compose.yml 里的
#     ${VAR:-默认值} 替换（db / redis / app / worker / nginx，以及 app/worker 的 build.args）
#   * 在**宿主机**直接跑 Django（`uv run python manage.py ...`）时，变量来自进程环境；
#     Django 自己不读 .env，需要 `set -a; . ./.env; set +a` 或自行 export
#
# 语法要点（compose 的 .env 解析规则，实测）：
#   * `#` 前面只要有空格就当成行内注释：`B=p #ss` 得到 "p"；紧贴着则保留：`A=p#ss` 得到 "p#ss"
#   * `$` 会做变量插值：`pa$word` 得到 "pa"（$word 未定义，被替换成空）
#     想要字面量 $ 就写 `$$`（`pa$$word` → "pa$word"），或用单引号 `'pa$word'`
#   * 行尾空格会被去掉；普通值不需要引号，只有含上面这些特殊字符时才需要
# =============================================================================


# -----------------------------------------------------------------------------
# 数据库（PostgreSQL / TimescaleDB）—— compose 的 db 服务与 Django 都读这几个
# -----------------------------------------------------------------------------
POSTGRES_DB=netops
POSTGRES_USER=netops
# ⚠️ 生产必须改。注意 postgres 官方镜像只在**首次初始化数据卷**时应用这个值：
#    之后再改它不会改数据库里的密码，反而会让 app 连不上（要么进库改密码，要么删卷重建）
POSTGRES_PASSWORD=netops_password
# 只影响「宿主机映射端口」；容器内固定 5432（compose 里 app 的 POSTGRES_HOST/PORT 写死 db:5432）
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Redis（Celery 的 broker 与 result backend）
# -----------------------------------------------------------------------------
# 同样只影响宿主机映射端口；容器内 app/worker 固定连 redis:6379
REDIS_PORT=6379
REDIS_DB=0
# 留空 = 不启用密码。设了密码要注意：app/worker 容器内也会带上它（settings.py 拼 REDIS_URL）
REDIS_PASSWORD=


# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# 逗号分隔；默认 *（无域名阶段放开）。上线后应改成实际域名/IP
DJANGO_ALLOWED_HOSTS=*


# -----------------------------------------------------------------------------
# nginx（只影响宿主机映射端口）
# -----------------------------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443


# -----------------------------------------------------------------------------
# 镜像构建
# -----------------------------------------------------------------------------
# 项目镜像的基础镜像（Dockerfile.app 的 ARG BASE_IMAGE，经 compose 的 build.args 传给
# app 与 worker）。换私有 registry 或别的 python 版本只改这一行，例如：
#     BASE_IMAGE=registry.example.com/netops-base:py312
BASE_IMAGE=network-ops-base:py312


# -----------------------------------------------------------------------------
# 以下只在「宿主机直接跑 Django」（不经容器）时才需要，别为 compose 打开
# -----------------------------------------------------------------------------
# compose 里 app/worker 的 POSTGRES_HOST=db、REDIS_HOST=redis 是写死的服务名：
#     POSTGRES_HOST=localhost
#     REDIS_HOST=localhost
#
# 配置仓库（data/config_repo）位置；默认 <项目根>/data/config_repo。
# 容器里对应的是命名卷 app_data 里的 /app/data/config_repo，改这个要同步 compose 的挂载：
#     CONFIG_REPO_PATH=


# -----------------------------------------------------------------------------
# 只在构建 Dockerfile.base 时用到的构建参数（不经过 compose，必须用 --build-arg 传）
# -----------------------------------------------------------------------------
# docker build --network=host -f Dockerfile.base -t network-ops-base:py312 \
#     --build-arg APK_MIRROR=mirrors.aliyun.com \
#     --build-arg PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple .
