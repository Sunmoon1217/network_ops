# =============================================================================
# network_ops —— **compose 自己的**变量文件
# =============================================================================
# 用法：
#     cp .env.example .env        # 然后按需修改；.env 已被 .gitignore 忽略
#
# 这个文件只服务 docker compose 本身：compose 会自动加载它，用于 docker-compose.yml 里
# 的 `${VAR:-默认值}` 替换。它**不会**被注入容器（compose 只把它当变量来源）。
#
# 三类配置各归各处，别放混：
#   .env（本文件）  → compose 插值：宿主映射端口、镜像、secrets 文件路径
#   env/*.env       → **容器进程**读的变量，按服务分别 env_file 注入：
#                       env/app.env       app + worker 的 Django 运行时（DB / Redis / DJANGO_*）
#                       env/db.env        只给 db（POSTGRES_DB / PGDATA / *_FILE）
#                       env/gunicorn.env  只给 app（GUNICORN_* 旋钮）
#                       env/celery.env    只给 worker（CELERY_LOGLEVEL）
#   env/secrets/*   → 数据库用户名 / 密码（docker secrets，进容器是 /run/secrets/*）
#                       生成：bash env/secrets/generate.sh
# 详见 env/README.md 与 env/secrets/README.md。
#
# ⚠️ compose 的 ${VAR} **只读本文件**，读不到 env/*.env。反过来，容器里的变量只要在
#    env/*.env 里就够了，不必在这里重复。
#
# 语法要点（compose 的 dotenv 解析规则，实测，env/*.env 同样适用）：
#   * `#` 前面只要有空格就当成行内注释：`B=p #ss` 得到 "p"；紧贴着则保留：`A=p#ss` 得到 "p#ss"
#   * `$` 会做变量插值：`pa$word` 得到 "pa"（$word 未定义，被替换成空）
#     想要字面量 $ 就写 `$$`（`pa$$word` → "pa$word"），或用单引号 `'pa$word'`
#   * 行尾空格会被去掉；普通值不需要引号，只有含上面这些特殊字符时才需要
# =============================================================================


# -----------------------------------------------------------------------------
# 宿主映射端口（**不是**容器内端口）
# -----------------------------------------------------------------------------
# 只影响「宿主机 → 容器」的端口映射；容器内固定 5432，app/worker 用服务名 db 连接
# （见 env/app.env 的 POSTGRES_HOST/POSTGRES_PORT）
POSTGRES_PORT=5432

# 同样只影响宿主机映射端口；容器内 app/worker 固定连 redis:6379
REDIS_PORT=6379

# nginx 统一入口
NGINX_PORT=8000
NGINX_SSL_PORT=8443


# -----------------------------------------------------------------------------
# 镜像构建
# -----------------------------------------------------------------------------
# 项目镜像的基础镜像（Dockerfile.app 的 ARG BASE_IMAGE，经 compose 的 build.args 传给
# app 与 worker）。换私有 registry 或别的 python 版本只改这一行，例如：
#     BASE_IMAGE=registry.example.com/netops-base:py312
BASE_IMAGE=network-ops-base:py312


# -----------------------------------------------------------------------------
# 可选：docker secrets 文件的位置
# -----------------------------------------------------------------------------
# 默认是项目里的 ./env/secrets/postgres_user 与 ./env/secrets/postgres_password。
# 放到别处（例如 /etc/netops/secrets/）时取消注释：
# POSTGRES_USER_SECRET_FILE=/etc/netops/secrets/postgres_user
# POSTGRES_PASSWORD_SECRET_FILE=/etc/netops/secrets/postgres_password


# -----------------------------------------------------------------------------
# 以下只在「宿主机直接跑 Django」（不经容器）时才需要，别为 compose 打开
# -----------------------------------------------------------------------------
# compose 里 app/worker 的环境变量来自 env/app.env（POSTGRES_HOST=db、REDIS_HOST=redis
# 是写死的服务名）。宿主机直跑时变量来自进程环境，Django 自己不读任何 .env：
#     set -a; . ./.env; set +a                                   # 本文件（端口等）
#     export POSTGRES_HOST=localhost REDIS_HOST=localhost
#     export POSTGRES_USER_FILE=env/secrets/postgres_user        # 凭据走 secrets 文件
#     export POSTGRES_PASSWORD_FILE=env/secrets/postgres_password
#     # 或不用 secrets：export POSTGRES_USER=netops POSTGRES_PASSWORD=...
#
# 配置仓库（data/config_repo）位置；默认 <项目根>/data/config_repo。
# 容器里对应的是 compose 里 `./data:/app/data` 这个 bind 挂载下的 config_repo，改这个要同步 compose 的挂载：
#     CONFIG_REPO_PATH=


# -----------------------------------------------------------------------------
# 只在构建 Dockerfile.base 时用到的构建参数（不经过 compose，必须用 --build-arg 传）
# -----------------------------------------------------------------------------
# docker build --network=host -f Dockerfile.base -t network-ops-base:py312 \
#     --build-arg APK_MIRROR=mirrors.aliyun.com \
#     --build-arg UV_DEFAULT_INDEX=https://mirrors.cloud.tencent.com/pypi/simple .
# （Python 包源要用 uv 自己的 UV_DEFAULT_INDEX：uv 不读 PIP_INDEX_URL / pip.conf）
