# 网络运维平台 - HTTPS 配置（默认未启用）
#
# 启用方式：
#   1. 准备证书（自签或正式）：
#        bash nginx/gen-self-signed-cert.sh
#      或放入已有的证书到 nginx/ssl/：
#        nginx/ssl/server.crt  （证书链）
#        nginx/ssl/server.key  （私钥）
#   2. 将本文件从 netops-ssl.conf.disabled 重命名为 netops-ssl.conf
#   3. 重载 nginx：
#        docker compose restart nginx
#
# 注意：本文件与 netops.conf 各自定义 $netops_upstream，互不依赖，
#      但两者都监听同一域名，通常一起启用（HTTP 与 HTTPS 并存）。

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    # 与 netops.conf 保持一致：用「变量 + resolver」而不是 upstream 块，
    # 这样 app 容器重建后 nginx 会重新解析地址，不必手工 reload。
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $netops_upstream "app:8000";

    # 证书
    ssl_certificate     /etc/nginx/ssl/server.crt;
    ssl_certificate_key /etc/nginx/ssl/server.key;

    # 协议与加密套件
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;

    # 会话缓存
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    client_max_body_size 100m;

    access_log /var/log/nginx/netops.ssl.access.log;
    error_log  /var/log/nginx/netops.ssl.error.log warn;

    location / {
        proxy_pass http://$netops_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_set_header Connection "";

        proxy_connect_timeout 10s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;

        proxy_buffering off;
    }
}

# 如需将 HTTP 强制跳转到 HTTPS，在 netops.conf 的 80 端口 server 块中
# 将 location / 替换为：
#
#     location / {
#         return 301 https://$host$request_uri;
#     }
