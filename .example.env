# compose 自身的变量文件：只给 compose 的 ${VAR} 插值，不注入容器。
# 用法：cp .example.env .env（.env 不入库）；进程配置在 envs/*.env，见 envs/README.md。
# 语法：值含 $ 或 # 时用单引号（compose 会插值 $，# 前有空格即注释）。

# 宿主映射端口（不是容器内端口；容器内固定 5432 / 3306）
REDIS_HOST_PORT=6379
NGINX_PORT=8000
NGINX_SSL_PORT=8443

# 镜像：代码镜像必填（git SHA 便于回滚）；改依赖才重建 venv 镜像。
# 构建顺序与跨沙箱传镜像见 handbook/deploy.md。
CODE_IMAGE=localhost/network-ops-code:dev
VENV_IMAGE=localhost/network-ops-venv:dev
# 传统方案（代码打进镜像，不挂载）
# APP_IMAGE=network-ops:latest
REDIS_IMAGE=redis:8.8.0

# 数据库后端：容器侧只改这里；切换后端等于换数据卷，不迁移旧数据。
DB_SERVICE=postgresql
DB_IMAGE_POSTGRES=timescale/timescaledb:2.27.1-pg16
DB_IMAGE_MYSQL=mysql:8.4-oracle
DB_PORT_POSTGRES=5432
DB_PORT_MYSQL=3306

# 容器环境分发（只影响 app / worker / consumer / beat）：不设即 container，生产写 prod。
# DJANGO_ENV=prod

# 可选：docker secrets 文件位置（默认 ./envs/secrets/db_user、db_password）
# DB_USER_SECRET_FILE=/etc/netops/secrets/db_user
# DB_PASSWORD_SECRET_FILE=/etc/netops/secrets/db_password

# 以下仅宿主直跑需要；宿主由 base.py 的 load_dotenv 兜底，不用手工 export。
# 首次：cp envs/example/*.env envs/；NETOPS_SKIP_DOTENV=1 可跳过全部 env 文件。
# CONFIG_REPO_PATH=
# ALIYUN_REGION=cn-hangzhou
# ALIYUN_PROD_ACCESS_KEY_ID=
# ALIYUN_PROD_ACCESS_KEY_SECRET=
# ALIYUN_TEST_ACCESS_KEY_ID=
# ALIYUN_TEST_ACCESS_KEY_SECRET=
# ALIYUN_ECS_ENDPOINT=
# ALIYUN_VPC_ENDPOINT=
# ALIYUN_SLB_ENDPOINT=
# ALIYUN_SLS_ENDPOINT=
# ALIYUN_ASAPI_ENDPOINT=

# 构建 dockerfile.base / dockerfile.venv 的 --build-arg（不经过 compose）
# APT_MIRROR=
# UV_DEFAULT_INDEX=
