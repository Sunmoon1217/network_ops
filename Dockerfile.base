# syntax=docker/dockerfile:1
#
# 基础（OS 运行时）镜像：只装 git / libpq5 / 清理系统 pip，不含 Python 依赖、不含项目代码。
# 构建命令、分层取舍、镜像源、冒烟清单契约、踩过的坑：docker/README.md §2-§3

FROM python:3.12-slim

ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn

# 运行期只需要 git（配置仓库）与 libpq5（psycopg2 的系统库兜底）；**不装** build-essential /
# libpq-dev / curl —— 依赖都有 cp312 manylinux 轮子，编译工具只会把 gcc 与头文件带进运行期镜像。
# 同一层里清掉 apt 索引与基础镜像自带的系统 pip / site-packages，依赖只留 /opt/venv。
RUN set -eux; \
    sed -i "s#deb.debian.org#${APT_MIRROR}#g" /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git libpq5; \
    rm -rf /var/lib/apt/lists/*; \
    rm -rf "$(python -c 'import site; print(site.getsitepackages()[0])')" /usr/local/bin/pip*
