# app 与 worker 共用：Django 进程运行时要读的都在这里。
# 由 docker-compose.yml 的 `env_file` 注入这两个服务；db / nginx / redis 不读它。
#
# 四类配置的分工：
#   .env（根）  → 只给 **compose 自己**用（`${VAR}` 插值：宿主映射端口、镜像、secrets 路径）
#   env/*.env   → 给**容器进程**用，按服务分别注入（就是本文件所在的目录）
#   secrets/*   → 密钥（数据库用户名/密码），见 secrets/README.md
#   两者同名时：compose 的 `environment:` > `env_file`（后者按顺序，**后面的覆盖前面的**）
#
# 改动后 `docker compose up -d app worker` 生效；不需要重建镜像。

# ---- 数据库 ----------------------------------------------------------------
# 容器内走 compose 网络：用服务名与容器端口。注意这与根 .env 里的 POSTGRES_PORT
# （**宿主机映射端口**）是两码事，宿主端口改了也不影响容器内连接。
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=netops
# 凭据只从 secrets 文件读（settings.py 的 _env_or_file() 认 *_FILE，也支持直接给
# POSTGRES_USER / POSTGRES_PASSWORD，那是给宿主机直跑 Django 用的回退路径）
POSTGRES_USER_FILE=/run/secrets/postgres_user
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password

# ---- Redis（Celery 的 broker 与 result backend）-----------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# redis 官方镜像没有 *_FILE 机制，所以密码只能走环境变量；留空 = 不启用
REDIS_PASSWORD=

# ---- Django ----------------------------------------------------------------
# 逗号分隔；默认 *（无域名阶段放开）。上线后应改成实际域名/IP
DJANGO_ALLOWED_HOSTS=*
# CSRF 可信来源（Django 4+ 的 Origin 校验）。**正常拓扑留空即可**：nginx 用 $http_host
# 透传原样 Host（含端口），Origin 天然等于 Django 认为的「当前 host」。只有「浏览器
# 看到的来源 ≠ 转发给 Django 的 Host」时才需要（外层 LB/网关改写 Host、TLS 在外层终结
# 等），值必须带 scheme，逗号分隔，含 :// 与端口：
#   DJANGO_CSRF_TRUSTED_ORIGINS='https://netops.example.com,http://localhost:8000'
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- 启动行为（只有 app 的 docker/entrypoint.sh 读，worker 不跑 entrypoint）----
# 1（默认）= 容器启动时「有未应用的迁移才自动跑 migrate」（manage.py migrate_if_needed）。
# 并发安全：整段检查 + 迁移由 PostgreSQL advisory lock 串行化，多副本同时启动不会撞车
# （Django 自己不给 migrate 加锁）。迁移失败就退出，不会带着过期表结构对外服务。
# 0 = 跳过，迁移交给外部发布流水线或人工（命令见 env/README.md）。
MIGRATE_ON_START=1
