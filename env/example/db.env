# 只给 db 服务（TimescaleDB，基于 postgres 官方镜像）。
#
# ⚠️ postgres 官方 entrypoint 规定：`POSTGRES_USER` 与 `POSTGRES_USER_FILE`
#    **不能同时设置**（同时出现直接报错退出），密码同理。所以这里只写 *_FILE，
#    真正的值在 secrets/postgres_user、secrets/postgres_password。

POSTGRES_DB=netops
POSTGRES_USER_FILE=/run/secrets/postgres_user
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
PGDATA=/var/lib/postgresql/data
