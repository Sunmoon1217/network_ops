# 只给 app 服务：docker/entrypoint.sh 用 shell 插值把这些拼进 gunicorn 启动命令。
#
# 默认值写在同一处（entrypoint 里的 ${GUNICORN_WORKERS:-1} 这种写法），所以这里列出的
# 就是默认值，删掉或留空效果一样。名字是**本项目 compose 层**定的，不是 gunicorn 官方
# 机制（gunicorn 自己只认 GUNICORN_CMD_ARGS / PORT / WEB_CONCURRENCY）。
#
# 硬要求没有对应变量：--worker-class 与 --bind 0.0.0.0:8000 写死在 entrypoint 里
# （--bind 与 nginx 的 upstream 耦合，且它是 append 语义，做成变量只会给一个必然配错的旋钮）。

# 进程数。这里跑的是 UvicornWorker（异步 worker，每进程一个事件循环），不是 gunicorn
# 文档里同步 worker 那个「2×CPU+1」公式——通常取 CPU 核数即可。多副本时每个副本各起这么多。
GUNICORN_WORKERS=1
# 单个请求的超时（秒）。要大于 nginx 侧的 proxy_read_timeout 才有意义
GUNICORN_TIMEOUT=30
# 平滑重启单个 worker 的等待上限（秒）
GUNICORN_GRACEFUL_TIMEOUT=30
# keep-alive 连接的空闲秒数（gunicorn 默认 2）
GUNICORN_KEEP_ALIVE=2
# worker 处理多少个请求后自动重启（0 = 不重启）。长时间运行的内存增长可以靠它兜底；
# jitter 是随机抖动，避免所有 worker 同时重启造成抖动
GUNICORN_MAX_REQUESTS=0
GUNICORN_MAX_REQUESTS_JITTER=0
# debug / info / warning / error / critical
GUNICORN_LOG_LEVEL=info
