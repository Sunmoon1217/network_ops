"""zabbix_utils.aioapi 的局部 stub：修正库里 __getattr__ -> Callable 的错标。"""

from typing import Any, Awaitable, Callable

class APIObject:
    def __init__(self, name: str, parent: Any) -> None: ...
    def __getattr__(self, name: str) -> Callable[..., Awaitable[Any]]: ...

class AsyncZabbixAPI:
    client_session: Any
    def __init__(self, url: str | None = None, client_session: Any = None, timeout: int = 30, **kwargs: Any) -> None: ...
    def __getattr__(self, name: str) -> APIObject: ...  # 关键：替代库里错的 -> Callable
    async def login(self, token: str | None = None, user: str | None = None, password: str | None = None) -> None: ...
    async def logout(self) -> None: ...
