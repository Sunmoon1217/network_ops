# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
*.so
*.dylib
dist/
build/

# Virtual environments（.venv2 等临时环境一并覆盖）
.venv/
.venv*/
# 本机解释器版本由各人自己定，不入库：uv 会按它选解释器，
# 写死一个小版本号会让别的机器找不到解释器（且 UV_PYTHON_DOWNLOADS=never 时无法回退下载）
.python-version

# Linter / Type checkers
.ruff_cache/
.mypy_cache/
.pyright/
.pyrefly/
.django-stub-gen/

# Coverage / Testing
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# AI 会话工作区 / 知识库
# .workbuddy：AI 助手的项目级记忆（工作日志），与人无关，不入库
# .dsh：跨会话知识库的入口软链，真身在用户级 ~/.dsh/skills（见 AGENTS.md「知识库」）
.workbuddy/
.mimocode/
.dsh/

# Environment
.env
.env.*
!.env.example

# Docker secrets（数据库凭据等）。放在 env/ 下与 env/*.env 作伴，但只有密钥被忽略：
# README 与生成脚本入库，postgres_user / postgres_password 不入库
env/secrets/*
!env/secrets/README.md
!env/secrets/generate.sh

# env/*.env 是部署本地配置，不入库；env/example/ 里的模板入库
env/*.env
!env/example/

# 分支数据库配置（由 scripts/switch-branch*.sh 生成）
.env.db

# Django
*.log
logs/
tmp/
local_settings.py
db.sqlite3
media/
staticfiles/
www/

# 运行期数据（Git 配置仓库、Excel 的 config_dir 源目录），见 AGENTS.md「项目结构」
data/*

# Frontend 自动生成（unplugin auto-import / components，dev server 启动时重建）
frontend/auto-imports.d.ts
frontend/components.d.ts

# Node (frontend)
node_modules/
.pnpm-store/

# Docker
docker-compose.override.yml

# nginx TLS 证书（配置文件提交，证书与私钥不提交）
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/ssl/*.pem

# OS
.DS_Store
Thumbs.db

# Archive / Misc
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz
nohup.out
.service.pid
network_ops-archive-*
