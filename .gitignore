# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
*.so
*.dylib
dist/
build/

# Virtual environments
.venv/
# 本机解释器版本由各人自己定，不入库：uv 会按它选解释器，
# 写死一个小版本号会让别的机器找不到解释器（且 UV_PYTHON_DOWNLOADS=never 时无法回退下载）
.python-version

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Environment
.env
.env.*
!.env.example

# Docker secrets（数据库凭据等）。放在 env/ 下与 env/*.env 作伴，但只有密钥被忽略：
# README 与生成脚本入库，postgres_user / postgres_password 不入库
env/secrets/*
!env/secrets/README.md
!env/secrets/generate.sh

# Django
*.log
logs/
tmp/
local_settings.py
db.sqlite3
media/
staticfiles/
www/

# Coverage / Testing
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/

# Type checkers
.mypy_cache/
.pyright/
.pyrefly/

# uv / pip

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Archive
*.tar
*.tar.gz
*.tar.bz2
*.tar.xz

# Node (frontend)
node_modules/
.pnpm-store/

# Misc
nohup.out
.service.pid

# Reference archive
network_ops-archive-*

# AI / Compose
.mimocode/
docs/

# Database init scripts (keep in repo)

# Auto-generated types
.django-stub-gen/
data/*
www/*

# nginx TLS 证书（配置文件提交，证书与私钥不提交）
nginx/ssl/*.crt
nginx/ssl/*.key
nginx/ssl/*.pem

# 分支数据库配置（由 scripts/switch-branch*.sh 生成）
.env.db

# 跨会话知识库的入口软链（真身在用户级 ~/.dsh/skills，见 AGENTS.md「知识库」）
.dsh/
