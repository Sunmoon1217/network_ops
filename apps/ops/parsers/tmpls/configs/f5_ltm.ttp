# F5 BIG-IP Device Configuration TTP Template

<group name="nodes">
ltm node {{ name | _start_ }} {
    address {{ address }}
} {{ _end_ }}
</group>

<group name="pools">
ltm pool {{ name | _start_ }} {
    load-balancing-mode {{ mode }}
    monitor {{ monitor | ORPHRASE }}
    <group name="members">
    members { {{ _start_ }}
        <group>
        {{ name | _start_ }}:{{ port }} {
            address {{ address }}
        } {{ _end_ }}
        </group>
    } {{ _end_ }}
    </group>
} {{ _end_ }}
</group>

<group name="virtuals">
ltm virtual {{ name | _start_ }} {
    destination /Common/{{ vs_address }}:{{ vs_port }}
    {{ status | equal("disabled") | default("enabled") }}
    ip-protocol {{ protocol }}
    mask {{ mask }}
    <group name="persist">
    persist { {{ _start_ }}
        <group>
        {{ name }} { }
        {{ name }} {
            {{ ignore | ORPHRASE }}
        } {{ _end_ }}
        </group>
    } {{ _end_ }}
    </group>
    pool {{ pool }}
    <group name="profiles" method="table">
    profiles { {{ _start_ }}
        <group>
        {{ name }} { }
        {{ name }} {
            {{ ignore | ORPHRASE }}
        } {{ _end_ }}
        </group>
    } {{ _end_ }}
    </group>
    <group name="rules" method="table">
    rules { {{ _start_ }}
        {{ name | joinmatches | to_list}}
    } {{ _end_ }}
    </group>
    source {{ source }}
    <group name="snat">
    source-address-translation { {{ _start_ }}
        pool {{ snat_pool }}
        type {{ snat_type }}
    } {{ _end_ }}
    </group>
} {{ _end_ }}
</group>
