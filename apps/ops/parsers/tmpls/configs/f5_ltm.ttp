# F5 BIG-IP Device Configuration TTP Template

<group name="nodes">
ltm node {{ name | _start_ }} {
    address {{ address }}
} {{ _end_ }}
</group>

<group name="pools*">
ltm pool {{ name | _start_ }} {
    load-balancing-mode {{ mode }}
    monitor {{ monitor | ORPHRASE }}
    <group name="members*">
    members { {{ _start_ }}
        <group>
        {{ name }} {
            address {{ address }}
        } {{ _end_ }}
        </group>
    } {{ _end_ }}
    </group>
} {{ _end_ }}
</group>

<group name="virtuals">
ltm virtual {{ name | _start_ }} {
    destination /Common/{{ vs_address }}:{{ vs_port }}
    ip-protocol {{ protocol }}
    mask {{ mask }}
    pool {{ pool }}
    <group name="persist">
    persist { {{ _start_ }}
        <group>
        {{ name }} {
            {{ ignore | ORPHRASE }}
        } {{ _end_ }}
        </group>
        <group>
        {{ name }} { }
        </group>
    } {{ _end_ }}
    </group>
    <group name="profiles">
    profiles { {{ _start_ }}
        <group>
        {{ name }} {
            {{ ignore | ORPHRASE }}
        } {{ _end_ }}
        </group>
        <group>
        {{ name }} { }
        </group>
    } {{ _end_ }}
    </group>
    <group name="rules">
    rules { {{ _start_ }}
        <group>
        {{ name }}
        </group>
    } {{ _end_ }}
    </group>
    source {{ source }}
    <group name="sant">
    source-address-translation { {{ _start_ }}
        pool {{ snat_pool }}
        type {{ snat_type }}
    } {{ _end_ }}
    </group>
} {{ _end_ }}
</group>
