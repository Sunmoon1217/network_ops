# F5 BIG-IP Device Configuration TTP Template

<group name="nodes">
ltm node {{ name | _start_ }} {
    address {{ address }}
} {{ _end_ }}
</group>

# pool 成员写的是 /Common/名字:端口，但名字本身是 IPv6 字面量时冒号会歧义，
# F5 改用一个点号分隔端口：/Common/2001:db8::1.80。所以成员要两条备选行（下面
# 那条是回退），**并且端口必须限成纯数字**：不限的话冒号那条会把 IPv6 成员贪婪
# 切成 name="/Common/2001:db8:"、port="1.80"，永远轮不到回退行。
# re() 只认 vars 块里声明的名字或内置名，不能内联写正则。
<vars>
PORT = r"\d+"
</vars>

# 注释是纯文本不是 XML 注释，里面不能出现尖括号，否则会被当成未闭合标签。
<group name="pools">
ltm pool {{ name | _start_ }} {
    load-balancing-mode {{ mode }}
    monitor {{ monitor | ORPHRASE }}
    <group name="members">
    members { {{ _start_ }}
        <group>
        {{ name | _start_ }}:{{ port | re("PORT") }} {
            address {{ address }}
        } {{ _end_ }}
        {{ name | _start_ }}.{{ port | re("PORT") }} {
            address {{ address }}
        } {{ _end_ }}
        </group>
    } {{ _end_ }}
    </group>
} {{ _end_ }}
</group>

# 注意 destination 要区分 IPv4 / IPv6：IPv6 用「点号」分隔端口
# （/Common/2001:db8::1.80），与 IPv4 的冒号写法不同。不区分的话 IPv6 会被按
# 冒号切坏，解析出 "2001:db8:" + 端口 "1.80" 这种残值，查不到对应虚拟服务器。
# 注释必须写在 group 标签之外，否则 TTP 会把它当成待匹配的行并报 variable not found。
<group name="virtuals">
ltm virtual {{ name | _start_ }} {
    destination /Common/{{ vs_address | re("IP") }}:{{ vs_port }}
    destination /Common/{{ vs_address | re("IPV6") }}.{{ vs_port }}
    {{ status | equal("disabled") | default("enabled") }}
    ip-protocol {{ protocol }}
    mask {{ mask }}
    <group name="persist">
    persist { {{ _start_ }}
        <group>
        {{ name }} { }
        {{ name }} {
            {{ ignore | ORPHRASE }}
        } {{ _end_ }}
        </group>
    } {{ _end_ }}
    </group>
    pool {{ pool }}
    <group name="profiles" method="table">
    profiles { {{ _start_ }}
        <group>
        {{ name }} { }
        {{ name }} {
            {{ ignore | ORPHRASE }}
        } {{ _end_ }}
        </group>
    } {{ _end_ }}
    </group>
    <group name="rules" method="table">
    rules { {{ _start_ }}
        {{ name | joinmatches | to_list}}
    } {{ _end_ }}
    </group>
    source {{ source }}
    <group name="snat">
    source-address-translation { {{ _start_ }}
        pool {{ snat_pool }}
        type {{ snat_type }}
    } {{ _end_ }}
    </group>
} {{ _end_ }}
</group>
