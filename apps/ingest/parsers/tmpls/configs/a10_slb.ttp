<vars>
ADDR = r"(?:[a-fA-F0-9]{1,4}:|:){1,7}(?:[a-fA-F0-9]{1,4}|:?)|(?:[0-9]{1,3}\.){3}[0-9]{1,3}"
</vars>

<group name="servers*">
slb server {{ name }} {{ address }}
   health-check {{ server_monitor | ORPHRASE }}
   disable {{ enabled | set(0) | default(1) }}
   {{ server_nocheck | ORPHRASE | equal("no health-check") }}
   <group name="services*">
   port {{ port }}  {{ protocol }}
       disable {{ enabled | set(0) | default(1) }}
       health-check {{ monitor | ORPHRASE }}
       {{ nocheck | ORPHRASE | equal("no health-check") }}
   </group>
{{ raw_lines | _line_ | joinmatches("\n") }}
</group>

<group name="service_groups*">
slb service-group {{ name }} {{ protocol }}
    method {{ method }}
    health-check {{ monitor | ORPHRASE | strip('"') | default("None") }}
    <group name="members*">
    member {{ address | re("ADDR") }}{{ sep | re("[:.]") }}{{ port | re("[0-9]+") }}{{ enabled | re("(?: ?disable)?") }}
    </group>
{{ raw_lines | _line_ | joinmatches("\n") }}
</group>

<group name="virtual_server*">
slb virtual-server {{ name }} {{ address }}
   <group name="virtual_services*">
   port {{ port }}  {{ protocol }}
      disabled {{ enabled | set(0) | default(1) }}
      source-nat {{ snat_type }} {{ snat_pool }}
      service-group {{ service_group }}
      template http {{ http_tmpl }}
      template persist {{ persist_type }} {{ persist_name }}
      template client-ssl {{ ssl_name }}
  </group>
{{ raw_lines | _line_ | joinmatches("\n") }}
</group>

<group name="account">
</group>
