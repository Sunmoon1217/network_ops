# syntax=docker/dockerfile:1
#
# Python 虚拟环境（venv）镜像：只装 uv sync 产物，不含 OS 依赖、不含项目代码。
# FROM ${BASE_IMAGE}（Dockerfile.base）继承 git / libpq5 / libmariadb3。
#
# **两阶段构建**：mysqlclient 在 PyPI 没有 manylinux 轮子（只有 sdist），必须现场编译，
# 而基础镜像刻意不装编译器。所以编译器与 MySQL 头文件只出现在 build 阶段，运行阶段
# 只 `COPY --from=build /opt/venv`，基础镜像「不带 build-essential」的取舍不变。
# 构建命令、分层取舍、镜像源、冒烟清单契约、踩过的坑：docker/README.md §2-§3

ARG BASE_IMAGE=localhost/network-ops-base:py312

# ---- 构建阶段：只为编译 mysqlclient 存在的工具链 ----
FROM ${BASE_IMAGE} AS build

ARG UV_DEFAULT_INDEX=https://mirrors.cloud.tencent.com/pypi/simple

ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=${VIRTUAL_ENV}/bin:${PATH}
ENV UV_PYTHON_DOWNLOADS=never

RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential pkg-config default-libmysqlclient-dev; \
    rm -rf /var/lib/apt/lists/*

# uv sync 只认 pyproject.toml + uv.lock（--no-install-project），把两份文件拷到临时目录、
# 跑完即删：运行阶段的 /app 由 code 卷覆盖，不该残留构建期文件。
COPY pyproject.toml uv.lock /opt/app/
WORKDIR /opt/app

RUN --mount=from=ghcr.io/astral-sh/uv:0.13,source=/uv,target=/usr/local/bin/uv \
    uv venv --python python3 "${VIRTUAL_ENV}" \
    && uv sync --frozen --no-dev --no-install-project --active --no-cache \
    && rm -rf /opt/app /root/.cache/uv \
    && find "${VIRTUAL_ENV}" -name '__pycache__' -type d -prune -exec rm -rf {} +

# ---- 运行阶段：只有 venv，没有编译器与头文件 ----
FROM ${BASE_IMAGE}

ENV VIRTUAL_ENV=/opt/venv
ENV PATH=${VIRTUAL_ENV}/bin:${PATH}
ENV UV_PYTHON_DOWNLOADS=never

# 运行时 CWD：app/worker/consumer 直接跑本镜像 + 挂载 code_data:/app，
# 没有 WORKDIR 的话 CWD 落在 /，python manage.py 会找成 //manage.py
WORKDIR /app

COPY --from=build ${VIRTUAL_ENV} ${VIRTUAL_ENV}

# 冒烟清单：一次 import 全部顶层依赖（含两个数据库驱动），缺运行期库时在构建期就炸。
RUN python -c "import importlib.metadata as m, zoneinfo; \
    zoneinfo.ZoneInfo('Asia/Shanghai'); \
    [__import__(n) for n in ('django','rest_framework','django_filters','psycopg2','MySQLdb','ttp','git','openpyxl','requests','dns','celery','redis','gunicorn','uvicorn_worker','aliyunsdkcore','aliyunsdkasapi','aliyunsdkecs','aliyunsdkslb','aliyunsdksls','aliyunsdkvpc','aliyun.log','lz4','google.protobuf')]; \
    print('deps ok:', {n: m.version(n) for n in ('django','djangorestframework','psycopg2-binary','mysqlclient','ttp','GitPython','openpyxl','requests','dnspython','celery','redis','gunicorn','uvicorn','uvicorn-worker','aliyun-log-python-sdk','aliyun-python-sdk-core')})"
