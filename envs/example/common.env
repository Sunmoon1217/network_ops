# 共享层：直接部署（宿主直跑）与 compose 部署**读同一份**——唯一需要日常维护的文件。
#
# 三层分工（完整说明见 envs/README.md）：
#   common.env    本文件：两种部署完全一致的值
#   container.env 容器差异（compose env_file 注入，几乎恒定）
#   host.env      宿主差异（base.py 启动时补进进程环境，几乎恒定）
#   gunicorn.env / celery.env   服务级小文件（compose 专用，宿主不读）
#   secrets/*     密钥：容器走 *_FILE=/run/secrets/*，宿主可经 host.env 指向同一份文件
#
# 加载方式：
#   容器：compose 的 env_file 注入为真实环境变量（compose.yml）
#   宿主：netops/settings/base.py 启动时 load_dotenv（进程环境优先，文件只兜底）
#
# 只放「两种部署完全一致」的值；凡是 HOST、*_FILE、DJANGO_ENV 这类按部署方式变化的，
# 一律放差异层，不许写在这里。
#
# 语法：compose dotenv 规则——值里含 $ 或 # 用单引号包起来（compose 会插值 $、
# # 前有空格即行内注释）。

# ---- 数据库 ----------------------------------------------------------------
# 本文件**不再放数据库连接**：容器侧由 envs/db.env（${} 嵌套后 env_file 注入）负责，
# 宿主直跑由 envs/host.env（DB_ENGINE / DB_HOST / DB_NAME）负责。
# settings 只认 DB_* 一套名字；镜像认的 POSTGRES_* / MYSQL_* 只在 db.env 里出现。
# 库名/端口也不在这里：端口由 base.py 按 DB_ENGINE 取默认（PG 5432 / MySQL 3306）。

# ---- Redis（Celery 的 broker 与 result backend）-----------------------------
REDIS_PORT=6379
REDIS_DB=0
# redis 官方镜像没有 *_FILE 机制，所以密码只能走环境变量；留空 = 不启用
REDIS_PASSWORD=

# ---- Django ----------------------------------------------------------------
# 逗号分隔；默认 *（无域名阶段放开）。上线后应改成实际域名/IP
DJANGO_ALLOWED_HOSTS=*
# CSRF 可信来源（Django 4+ 的 Origin 校验）。**正常拓扑留空即可**：nginx 用 $http_host
# 透传原样 Host（含端口），Origin 天然等于 Django 认为的「当前 host」。只有「浏览器
# 看到的来源 ≠ 转发给 Django 的 Host」时才需要（外层 LB/网关改写 Host、TLS 在外层终结
# 等），值必须带 scheme，逗号分隔，含 :// 与端口：
#   DJANGO_CSRF_TRUSTED_ORIGINS='https://netops.example.com,http://localhost:8000'
DJANGO_CSRF_TRUSTED_ORIGINS=

# ---- 访问流（AccessFlow）旋钮 ------------------------------------------------
# 背压阈值（生产者投递前查 Stream 未投递积压，超过即让路）；默认 500
#ACCESS_FLOW_MAX_QUEUE=500
# 投递开关（测试由 conftest 统一置 0）
#ACCESS_FLOW_DISPATCH=1

# ---- 阿里云 ----------------------------------------------------------------
# 两套账号（prod/test），共用 region；各产品 endpoint 分设。
# 凭据 *_FILE 按部署方式分文件（container.env / host.env），这里只放非密钥项。
# ALIYUN_REGION=cn-hangzhou          # 区域（两个账号共用）
# ALIYUN_ECS_ENDPOINT=               # ECS endpoint（不设走默认公网接入点）
# ALIYUN_VPC_ENDPOINT=               # VPC（含 VSwitch）endpoint
# ALIYUN_SLB_ENDPOINT=               # SLB endpoint
# ALIYUN_SLS_ENDPOINT=               # SLS endpoint
# ALIYUN_ASAPI_ENDPOINT=             # ASAPI endpoint

# ---- Dify 知识库（docs 文档转换的推送目标）------------------------------------
# 文档转换产物（md / 自包含 html，pdf 直传）经知识库 API 推入自托管 Dify 的固定知识库。
# 三项（URL / KEY / DATASET_ID）齐备才启用推送；缺失时推送接口返回 503，转换与留档不受影响。
# 注意：值里含 $ 或 # 一律用单引号包起来（compose 会插值 $、# 前有空格即注释）。
# DIFY_API_BASE_URL=               # 知识库 API 地址（含 /v1），如 https://dify.example.com/v1
# DIFY_DATASET_ID=                 # 目标知识库（dataset）ID
# DIFY_INDEXING_TECHNIQUE=high_quality   # 索引方式：high_quality（默认）/ economy
# DIFY_TIMEOUT=30                  # HTTP 超时秒数
# DIFY_PROCESS_MODE=automatic      # 分段模式：automatic（默认）/ custom
# DIFY_SEGMENT_SEPARATOR='\n'       # custom 模式分段分隔符（\n \t 转义会还原；表格类可按行切）
# DIFY_SEGMENT_MAX_TOKENS=500      # custom 模式分段 token 上限
# API Key（Bearer）按部署方式分文件：容器 container.env 给 *_FILE=/run/secrets/dify_api_key，
# 宿主 host.env 给 DIFY_API_KEY=<值>（或指向同一份密钥文件）

# ---- Zabbix API（ingest 采集器的数据源）--------------------------------------
# ZABBIX_URL=                      # Zabbix 前端地址（未配置则 get_zapi 拒绝创建）
# ZABBIX_TIMEOUT=30                # HTTP 超时秒数（默认 30）
# ZABBIX_TOKEN=                    # API Token（Zabbix >= 5.4；与 USER/PASSWORD 二选一，token 优先）
# ZABBIX_USER=                     # 用户名登录（Zabbix < 7.2 走 API user.login）
# ZABBIX_PASSWORD=                 # 用户名登录的密码（值含 $ 或 # 用单引号）

# ---- MCP 工具出口（/mcp）-----------------------------------------------------
# 出口**匿名**：能访问到端点就能调工具，身份与配额只到「客户端 IP」这一层。
# 0 = 摘掉出口：不 import llmtools、不建 MCP 子应用、/mcp 直接 404（重启 app 生效）。
# MCP_ENABLED=1
# 每 IP 每分钟的调用上限（0 = 不限流；Redis 不可用时放行，只告警）。
# MCP_RATE_LIMIT_PER_MINUTE=60
