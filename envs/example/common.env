# 共享层：宿主直跑与 compose 读同一份，日常只维护这里。
# 三层分工与加载顺序见 envs/README.md；变量全表见 handbook/settings.md。
# 语法：值含 $ 或 # 用单引号（compose 会插值 $，# 前有空格即注释）。

# 数据库（与部署方式无关的部分；容器侧后端由根 .env 的 DB_SERVICE 决定）
DB_ENGINE=${DB_SERVICE:-postgresql}
DB_NAME=netops
DB_USER=netops
# 镜像认的库名 / 账号：同文件内 ${} 嵌套，db 容器据此初始化
POSTGRES_DB=${DB_NAME}
MYSQL_DATABASE=${DB_NAME}
MYSQL_USER=${DB_USER}

# Redis（Celery 的 broker 与 result backend）
REDIS_PORT=6379
REDIS_DB=0
# redis 官方镜像没有 *_FILE 机制，密码只能走环境变量；留空 = 不启用
REDIS_PASSWORD=

# Django
# 逗号分隔；默认 *（无域名阶段），上线后应改成实际域名/IP
DJANGO_ALLOWED_HOSTS=*
# 正常拓扑留空；仅当浏览器来源 ≠ 转给 Django 的 Host 时填写（带 scheme、逗号分隔）
DJANGO_CSRF_TRUSTED_ORIGINS=

# 策略参数（访问流阈值、大屏周期、各超时、Dify 分段等）有代码默认值，
# 通常不用写；需要现场覆盖时取消注释。清单见 handbook/settings.md。

# 阿里云：两套账号（prod/test），共用 region；凭据 *_FILE 在 container.env / host.env。
# ALIYUN_REGION=cn-hangzhou
# ALIYUN_ECS_ENDPOINT=
# ALIYUN_VPC_ENDPOINT=
# ALIYUN_SLB_ENDPOINT=
# ALIYUN_SLS_ENDPOINT=
# ALIYUN_ASAPI_ENDPOINT=

# Dify 知识库（docs 文档转换的推送目标）；URL / KEY / DATASET_ID 齐备才启用。
# DIFY_API_BASE_URL=https://dify.example.com/v1
# DIFY_DATASET_ID=
# DIFY_API_KEY 的存放方式见 container.env（*_FILE）与 host.env（直接给值或 *_FILE）

# Zabbix API（ingest 采集器的数据源）；未配置则 get_zapi 拒绝创建，token 优先于用户名密码。
# ZABBIX_URL=
# ZABBIX_TOKEN=
# ZABBIX_USER=
# ZABBIX_PASSWORD=

# autotask（大屏的工单 / 巡检 / SLB 源）；内网 HTTP 服务，无凭据。
# AUTOTASK_BASE_URL=
