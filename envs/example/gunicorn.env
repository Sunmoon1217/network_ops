# 只给 app 服务：entrypoint/app.sh 用 shell 插值拼进 gunicorn 启动命令。
# 默认值只在 entrypoint 里写一份，这里留空与删掉等价；旋钮说明见 handbook/deploy.md。

# worker 进程数（UvicornWorker，通常取 CPU 核数）
GUNICORN_WORKERS=1
# 单请求超时（秒），应大于 nginx 的 proxy_read_timeout
GUNICORN_TIMEOUT=30
# 平滑重启单个 worker 的等待上限（秒）
GUNICORN_GRACEFUL_TIMEOUT=30
# keep-alive 空闲秒数
GUNICORN_KEEP_ALIVE=2
# 处理多少个请求后重启（0 = 不重启）；jitter 避免所有 worker 同时重启
GUNICORN_MAX_REQUESTS=0
GUNICORN_MAX_REQUESTS_JITTER=0
# debug / info / warning / error / critical
GUNICORN_LOG_LEVEL=info
