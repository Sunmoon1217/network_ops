# 宿主差异层：宿主直跑（uv run manage.py ...）相对 compose 的差异。
# 由 base.py 的 load_dotenv 加载（DJANGO_ENV ≠ container 时），进程环境永远优先。
# 常规开发不用配（不设 DJANGO_ENV 即 dev）；完整加载规则见 envs/README.md。

# 连本机（或 compose 映射到宿主的端口）。写 127.0.0.1 而不是 localhost：
# Windows 上 localhost 会先试 ::1，每次连接白等约 10s。
DB_HOST=127.0.0.1
REDIS_HOST=127.0.0.1

# 可选：与容器共用同一份 secrets（相对路径按 BASE_DIR 解析）
#DB_USER_FILE=envs/secrets/db_user
#DB_PASSWORD_FILE=envs/secrets/db_password
#ALIYUN_PROD_ACCESS_KEY_ID_FILE=envs/secrets/prod_ak
#ALIYUN_PROD_ACCESS_KEY_SECRET_FILE=envs/secrets/prod_sk
#ALIYUN_TEST_ACCESS_KEY_ID_FILE=envs/secrets/test_ak
#ALIYUN_TEST_ACCESS_KEY_SECRET_FILE=envs/secrets/test_sk
#DIFY_API_KEY_FILE=envs/secrets/dify_api_key

# 服务器直跑生产时打开（prod.py 硬关 DEBUG 并校验必填项）；本机开发保持注释。
#DJANGO_ENV=prod
