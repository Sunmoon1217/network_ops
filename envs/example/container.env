# 容器差异层：compose 的 env_file 排在最后，注入 app / worker / consumer / beat。
# 值几乎恒定；共享值在 common.env，宿主差异在 host.env。加载规则见 envs/README.md。

# 容器内走 compose 网络的服务名（db 容器本身不读这两项）
DB_HOST=db
REDIS_HOST=redis

# 阿里云凭据走 docker secrets（compose 挂载）
ALIYUN_PROD_ACCESS_KEY_ID_FILE=/run/secrets/prod_ak
ALIYUN_PROD_ACCESS_KEY_SECRET_FILE=/run/secrets/prod_sk
ALIYUN_TEST_ACCESS_KEY_ID_FILE=/run/secrets/test_ak
ALIYUN_TEST_ACCESS_KEY_SECRET_FILE=/run/secrets/test_sk

# 配置仓库（git）挂载点，对应命名卷 repo；宿主直跑用默认 <项目根>/data/config_repo
CONFIG_REPO_PATH=/configs

# 大屏链路配置：宿主 conf/ 只读挂到 /etc/netops/conf
DASHBOARD_LINKS_FILE=/etc/netops/conf/links.json

# settings 环境选择：容器必须显式选 container（base.py 据此不加载 host.env）
DJANGO_ENV=container

# 启动行为：1 = 有未应用迁移时自动 migrate（按需、数据库命名锁串行化）；
# 0 = 跳过，交给外部流水线或人工。
MIGRATE_ON_START=1
