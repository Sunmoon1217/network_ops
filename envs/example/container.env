# 差异层（容器）：compose 部署相对宿主直跑的「硬差异」。值几乎恒定，基本不用改。
#
# compose.yml 的 env_file 把它**排在最后**（后面的覆盖前面的），注入 app / worker /
# consumer / beat 四个应用进程；宿主直跑不读本文件（base.py 按 DJANGO_ENV 区分）。
# db 容器**不读本文件**：它的连接参数由 compose.db.yml 的模板从 DB_* 嵌套成镜像认的名字。
# 共享值在 common.env，宿主差异在 host.env——改常规配置不要动这里。

# ---- Redis：走 compose 网络的服务名 -----------------------------------------
# 数据库的 DB_HOST / 凭据 *_FILE 不在本文件：它们由 compose.yml 的 x-db-env 统一下发给四个
# 应用进程（见那里的注释）；本文件只放各服务自己的差异项。
REDIS_HOST=redis

# ---- 阿里云凭据：同上走 secrets（compose 已挂载）-----------------------------
ALIYUN_PROD_ACCESS_KEY_ID_FILE=/run/secrets/aliyun_prod_access_key_id
ALIYUN_PROD_ACCESS_KEY_SECRET_FILE=/run/secrets/aliyun_prod_access_key_secret
ALIYUN_TEST_ACCESS_KEY_ID_FILE=/run/secrets/aliyun_test_access_key_id
ALIYUN_TEST_ACCESS_KEY_SECRET_FILE=/run/secrets/aliyun_test_access_key_secret

# ---- 配置仓库（git）与配置源 --------------------------------------------------
# 容器里挂命名卷 repo（compose.yml 的 volumes 段，挂载点 /configs）；宿主直跑不设它，
# 走默认 <项目根>/data/config_repo。
CONFIG_REPO_PATH=/configs

# ---- 大屏链路配置 --------------------------------------------------------------
# 宿主 conf/ 只读挂到容器 /etc/netops/conf（compose.yml 的 volumes 段）；
# 宿主直跑用默认 conf/links.json（相对 BASE_DIR），不需要设这一行。
DASHBOARD_LINKS_FILE=/etc/netops/conf/links.json

# ---- settings 环境选择 --------------------------------------------------------
# settings 分层：base 打底，dev/container/prod 按 DJANGO_ENV 覆盖（见 netops/settings/）。
# 容器必须显式选 container（base.py 据此不加载 host.env）；不设按 dev 的 127.0.0.1 默认、
# 快速失败；未知值直接拒绝启动（白名单 dev/container/prod）。
DJANGO_ENV=container

# ---- 启动行为（只有 app 的 entrypoint/app.sh 读，worker 不读）-----------------
# 1（默认）= 容器启动时「有未应用的迁移才自动跑 migrate」（manage.py migrate_if_needed）。
# 并发安全：整段检查 + 迁移由数据库自带的命名锁串行化（PG advisory / MySQL GET_LOCK）。
# 0 = 跳过，迁移交给外部发布流水线或人工：docker compose run --rm app python manage.py migrate
MIGRATE_ON_START=1
