# ---- 数据库（两个后端共用；镜像认的名字在本文件内用 ${} 嵌套出来）------------
#
# 由 compose 的 env_file 直接加载：app / worker / consumer / beat 与 db 容器都读这一份。
# ⚠️ 这里的 ${} 是 **env_file 自身的插值**（Compose 加载时展开），不是 compose.yml 里的插值；
#    右侧引用的变量来自根 `.env` / shell，所以 DB_SERVICE、DB_NAME、DB_USER 在根 `.env`
#    维护一份就够，不需要在 compose.yml 里再写一遍 environment。
#
# 宿主直跑不读本文件：同样的值走 envs/common.env（DB_ENGINE）与 envs/host.env（DB_HOST、DB_NAME）。

DB_ENGINE=${DB_SERVICE:-postgresql}
DB_NAME=${DB_NAME:-netops}
DB_USER=${DB_USER:-netops}
DB_HOST=db

# 凭据文件路径：compose 把 db_user / db_password 挂到 /run/secrets/*（两个后端共用）
DB_USER_FILE=/run/secrets/db_user
DB_PASSWORD_FILE=/run/secrets/db_password

# ---- 嵌套：PostgreSQL 镜像认的名字 ----
POSTGRES_DB=${DB_NAME}
POSTGRES_USER_FILE=${DB_USER_FILE}
POSTGRES_PASSWORD_FILE=${DB_PASSWORD_FILE}

# ---- 嵌套：MySQL 镜像认的名字（用户名没有 *_FILE 机制，只能走明文环境变量）----
MYSQL_DATABASE=${DB_NAME}
MYSQL_USER=${DB_USER}
MYSQL_PASSWORD_FILE=${DB_PASSWORD_FILE}
MYSQL_ROOT_PASSWORD_FILE=${DB_PASSWORD_FILE}
