# ---- 数据库连接细节（仅容器）-------------------------------------------------
#
# 与部署无关的部分（DB_ENGINE / DB_NAME / DB_USER 及镜像认的库名/账号）在 envs/common.env，
# 本文件只补 docker secrets 的文件路径（宿主没有 /run/secrets）；DB_HOST 在 container.env
# （db 容器自己不用它，由四个应用进程消费）。
#
# ⚠️ ${} 是 env_file 自身的插值（Compose 加载时展开），不是 compose.yml 的插值。

DB_USER_FILE=/run/secrets/db_user
DB_PASSWORD_FILE=/run/secrets/db_password

# ---- 嵌套：镜像认的凭据变量名 ----
POSTGRES_USER_FILE=${DB_USER_FILE}
POSTGRES_PASSWORD_FILE=${DB_PASSWORD_FILE}

# MySQL 用户名没有 *_FILE 机制（它在 common.env 的 MYSQL_USER），密码/root 都走文件
MYSQL_PASSWORD_FILE=${DB_PASSWORD_FILE}
MYSQL_ROOT_PASSWORD_FILE=${DB_PASSWORD_FILE}
